{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "menu-screen",
  "compatibility_date": "2026-09-15",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "menu.subsurfaces.net",
      "custom_domain": true
    }
  ]
}
